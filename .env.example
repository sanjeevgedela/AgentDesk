# Leave empty to use local persistent JSON and deterministic replay.
DATABASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Generate each token independently with openssl rand -hex 32.
AGENTDESK_SHOW_OPERATOR_ACCESS=false
AGENTDESK_OPERATOR_TOKEN=
RESEARCH_INTERNAL_TOKEN=

# Dedicated, funded Solana devnet wallet: JSON array of 64 bytes.
SOLANA_DEVNET_KEYPAIR=
RESEARCH_RECIPIENT=

# Private ElevenLabs agent configured with the client tools in README.md.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# A random secret of at least 32 characters for the quote collection job.
CRON_SECRET=

# Optional dedicated funded Solana devnet memo signer.
SOLANA_AGENT_KEYPAIR=
